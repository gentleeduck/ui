{
  "$schema": "https://json.schemastore.org/package.json",
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "gentleduck contributors",
  "bugs": {
    "url": "https://github.com/gentleeduck/gentleduck/issues"
  },
  "description": "A package for creating variants of components, providing a simple and efficient way to create variants of components.",
  "devDependencies": {
    "@gentleduck/tsdown-config": "workspace:*",
    "@gentleduck/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cva": "1.0.0-beta.4",
    "tailwind-variants": "^3.2.2",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "homepage": "https://github.com/gentleeduck/gentleduck/tree/master/packages/duck-variants#readme",
  "keywords": [
    "class-variants",
    "class-names",
    "tailwind",
    "tailwindcss",
    "utility-classes",
    "variants",
    "css-variants",
    "component-variants",
    "classnames",
    "cva",
    "gentleduck",
    "styling",
    "typescript",
    "react",
    "ui-utility",
    "ui-components"
  ],
  "sideEffects": false,
  "license": "MIT",
  "main": "./dist/index.js",
  "name": "@gentleduck/variants",
  "packageManager": "bun@1.3.5",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gentleeduck/gentleduck.git",
    "directory": "packages/duck-variants"
  },
  "scripts": {
    "benchmark": "bun run scripts/benchmark.ts",
    "build": "tsdown",
    "check": "biome check .",
    "check-types": "tsc -p tsconfig.json --noEmit --pretty false --skipLibCheck",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "0.1.23"
}
