{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "outDir": "./dist",
    "paths": {
      "~/*": ["./src/*"]
    },
    "rootDir": "./"
  },
  "exclude": ["node_modules", "dist", "**/*.tsbuildinfo", "tsconfig.tsbuildinfo"],
  "extends": "@gentleduck/typescript-config/react.json",
  "include": ["./src/**/*.ts", "./src/**/*.tsx"]
}
