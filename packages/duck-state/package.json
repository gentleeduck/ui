{
  "$schema": "https://json.schemastore.org/package.json",
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "gentleduck contributors",
  "bugs": {
    "url": "https://github.com/gentleeduck/duck-ui/issues"
  },
  "description": "Lightweight state management for gentleduck/ui.",
  "sideEffects": false,
  "devDependencies": {
    "@gentleduck/tsdown-config": "workspace:*",
    "@gentleduck/typescript-config": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "jsdom": "catalog:",
    "tsdown": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/gentleeduck/duck-ui/tree/master/packages/duck-state#readme",
  "keywords": [
    "gentleduck",
    "react",
    "components",
    "performance",
    "state-management"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "name": "@gentleduck/state",
  "packageManager": "bun@1.3.5",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gentleeduck/duck-ui.git",
    "directory": "packages/duck-state"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -p tsconfig.json --noEmit --pretty false --skipLibCheck",
    "test": "bun test"
  },
  "type": "module",
  "version": "0.2.5"
}
