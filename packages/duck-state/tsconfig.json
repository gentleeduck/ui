{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "isolatedDeclarations": false,
    "module": "esnext",
    "noEmit": true,
    "outDir": "./dist",
    "paths": {
      "~/*": ["./src/*"]
    },
    "rootDir": "./",
    "target": "esnext"
  },
  "exclude": ["node_modules", "dist", "src/__test__/**", "src/examples/**", "**/*.tsbuildinfo", "tsconfig.tsbuildinfo"],
  "extends": "@gentleduck/typescript-config/react.json",
  "include": ["./src/**/*.ts", "./src/**/*.tsx"]
}
