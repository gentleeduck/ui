{
  "$schema": "https://json.schemastore.org/package.json",
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "gentleduck contributors",
  "bugs": {
    "url": "https://github.com/gentleeduck/gentleduck/issues"
  },
  "description": "A package for lazy loading components and images, providing virtualized rendering to improve client-side performance.",
  "devDependencies": {
    "@gentleduck/tsdown-config": "workspace:*",
    "@gentleduck/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "jsdom": "catalog:",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "tsdown": "catalog:",
    "tsup": "^8.5.1",
    "vitest": "catalog:"
  },
  "exports": {
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "homepage": "https://gentleduck.org/duck-ui",
  "keywords": [
    "gentleduck",
    "lazy-loading",
    "react",
    "virtualization",
    "components",
    "performance",
    "intersection-observer",
    "image-lazy-loading",
    "lazy-load",
    "accessibility",
    "react-lazy-load"
  ],
  "license": "MIT",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "name": "@gentleduck/lazy",
  "packageManager": "bun@1.3.10",
  "peerDependencies": {
    "next": "^16.1.1",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gentleeduck/gentleduck.git",
    "directory": "packages/duck-lazy"
  },
  "scripts": {
    "build": "tsdown",
    "check": "biome check .",
    "check-types": "tsc -p tsconfig.json --noEmit --pretty false --skipLibCheck",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "type": "module",
  "version": "1.3.2"
}
