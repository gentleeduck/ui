{
  "$schema": "https://json.schemastore.org/package.json",
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "gentleduck contributors",
  "bugs": {
    "url": "https://github.com/gentleeduck/duck-ui/issues"
  },
  "description": "A package for lazy loading components and images, providing virtualized rendering to improve client-side performance.",
  "devDependencies": {
    "@gentleduck/tsdown-config": "workspace:*",
    "@gentleduck/typescript-config": "workspace:*",
    "@types/node": "^25.3.0",
    "@types/react": "19.2.14",
    "jsdom": "^29.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsdown": "0.21.7",
    "tsup": "^8.5.1"
  },
  "exports": {
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "homepage": "https://github.com/gentleeduck/duck-ui/tree/master/packages/duck-lazy#readme",
  "keywords": [
    "gentleduck",
    "lazy-loading",
    "react",
    "virtualization",
    "components",
    "performance",
    "intersection-observer",
    "image-lazy-loading",
    "lazy-load",
    "accessibility",
    "react-lazy-load"
  ],
  "license": "MIT",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "name": "@gentleduck/lazy",
  "packageManager": "bun@1.3.5",
  "peerDependencies": {
    "next": "^16.1.1",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gentleeduck/duck-ui.git",
    "directory": "packages/duck-lazy"
  },
  "scripts": {
    "check-types": "tsc -p tsconfig.json --noEmit --pretty false --skipLibCheck",
    "build": "tsdown",
    "test": "bun test"
  },
  "type": "module",
  "version": "1.2.15"
}
