{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "outDir": "./dist",
    "paths": {
      "~/*": ["./src/*"]
    },
    "rootDir": "./"
  },
  "exclude": [
    "node_modules",
    "dist",
    "src/**/__test__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.tsbuildinfo",
    "tsconfig.tsbuildinfo"
  ],
  "extends": "@gentleduck/typescript-config/react.json",
  "include": ["."]
}
