{
  "$schema": "https://json.schemastore.org/package.json",
  "engines": {
    "node": ">=22.0.0"
  },
  "bugs": {
    "url": "https://github.com/gentleeduck/gentleduck/issues"
  },
  "devDependencies": {
    "@gentleduck/tsdown-config": "workspace:*",
    "@gentleduck/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "clsx": "^2.1.1",
    "jsdom": "catalog:",
    "tailwind-merge": "^3.4.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "exports": {
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "homepage": "https://gentleduck.org/duck-ui",
  "description": "React hooks for Duck UI.",
  "keywords": [
    "gentleduck",
    "react",
    "hooks"
  ],
  "license": "MIT",
  "author": "gentleduck contributors",
  "module": "./dist/index.js",
  "name": "@gentleduck/hooks",
  "packageManager": "bun@1.3.10",
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "sideEffects": false,
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "directory": "packages/duck-hooks",
    "type": "git",
    "url": "git+https://github.com/gentleeduck/gentleduck.git"
  },
  "scripts": {
    "build": "tsdown",
    "check": "biome check .",
    "check-types": "tsc -p tsconfig.json --noEmit --pretty false --skipLibCheck",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "0.2.1"
}
