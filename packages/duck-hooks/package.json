{
  "$schema": "https://json.schemastore.org/package.json",
  "engines": {
    "node": ">=22.0.0"
  },
  "bugs": {
    "url": "https://github.com/gentleeduck/duck-ui/issues"
  },
  "devDependencies": {
    "@gentleduck/tsdown-config": "workspace:*",
    "@gentleduck/typescript-config": "workspace:*",
    "@types/node": "^25.3.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "tsdown": "0.18.3",
    "typescript": "5.9.3",
    "zod": "4.3.6"
  },
  "exports": {
    "./*": "./dist/*/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "homepage": "https://github.com/gentleeduck/duck-ui/tree/master/packages/duck-hooks#readme",
  "description": "React hooks for Duck UI.",
  "keywords": [
    "gentleduck",
    "react",
    "hooks"
  ],
  "license": "MIT",
  "author": "gentleduck contributors",
  "module": "./dist/index.js",
  "name": "@gentleduck/hooks",
  "packageManager": "bun@1.3.5",
  "peerDependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "directory": "packages/duck-hooks",
    "type": "git",
    "url": "git+https://github.com/gentleeduck/duck-ui.git"
  },
  "scripts": {
    "check-types": "tsc -p tsconfig.json --noEmit --pretty false --skipLibCheck",
    "build": "tsdown"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "0.1.8"
}
