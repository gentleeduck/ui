      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-markdown": {
      "optional": true
    },
    "react-resizable-panels": {
      "optional": true
    },
    "shiki": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    },
    "./styles/mdx.css": "./src/styles/mdx.css",
    "./velite": {
      "browser": "./dist/velite/browser.js",
      "default": "./dist/velite/index.js",
      "node": "./dist/velite/index.js",
      "types": "./dist/velite/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "name": "@gentleduck/docs",
  "packageManager": "bun@1.3.5",
  "sideEffects": [
    "./dist/styles/*.css"
  ],
  "private": false,
  "description": "Shared docs app kit used by the gentleduck/ui docs apps.",
  "keywords": [
    "gentleduck",
    "docs",
    "documentation",
    "mdx",
    "nextjs"
  ],
  "license": "MIT",
  "author": "gentleduck contributors",
