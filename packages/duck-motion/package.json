{
  "$schema": "https://json.schemastore.org/package.json",
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "gentleduck contributors",
  "bugs": {
    "url": "https://github.com/gentleeduck/duck-ui/issues"
  },
  "description": "Motion primitives for gentleduck/ui components.",
  "devDependencies": {
    "@gentleduck/tsdown-config": "workspace:*",
    "@gentleduck/typescript-config": "workspace:*",
    "tsdown": "0.18.3"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "./css": "./src/index.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "tsconfig.json",
    "src/index.css"
  ],
  "homepage": "https://github.com/gentleeduck/duck-ui/tree/master/packages/duck-motion#readme",
  "keywords": [
    "gentleduck",
    "motion",
    "animation",
    "ui"
  ],
  "license": "MIT",
  "name": "@gentleduck/motion",
  "packageManager": "bun@1.3.5",
  "peerDependencies": {
    "@gentleduck/variants": "workspace:*",
    "react": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "directory": "packages/duck-motion",
    "type": "git",
    "url": "git+https://github.com/gentleeduck/duck-ui.git"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -p tsconfig.json --noEmit --pretty false --skipLibCheck"
  },
  "type": "module",
  "types": "./index.ts",
  "version": "0.1.13"
}
