exports[`command help output > includes workspace option in all relevant commands 1`] = `
{
  "add": "Usage: add [options] [components...]

add components to your project

Arguments:
  components              names, url or local path to component to install when
                          you do not provide this you will be directed to a list
                          of the components to select from (default: [])

Options:
  -y, --yes               skip confirmation prompt. (default: false)
  -f, --force             overwrite existing components (default: false)
  -c, --cwd <cwd>         the working directory. defaults to the current
                          directory. (default:
                          "<CWD>")
  -w, --workspace <path>  workspace path override (relative to monorepo root)
  -a, --all               add all available components (default: false)
  -h, --help              display help for command
",
  "diff": "Usage: diff [options] [components...]

show differences between local and registry versions of components

Arguments:
  components              component name(s) to diff against the registry. If
                          omitted, shows a picker. (default: [])

Options:
  -c, --cwd <cwd>         the working directory. defaults to the current
                          directory. (default:
                          "<CWD>")
  -g, --gui               open in interactive GUI mode. (default: false)
  -w, --workspace <path>  workspace path override (relative to monorepo root)
  -h, --help              display help for command
",
  "init": "Usage: init [options] [components...]

init the project

Arguments:
  components                 names, url or local path to component to install
                             when you do not provide this you will be directed
                             to a list of the components to select from
                             (default: [])

Options:
  -y, --yes                  skip confirmation prompt. (default: false)
  -c, --cwd <cwd>            the working directory. defaults to the current
                             directory. (default:
                             "<CWD>")
  -p, --project-type <type>  project type (NEXT_JS, VITE, TANSTACK_START,
                             UNKNOWN)
  -b, --base-color <color>   base color theme (zinc, slate, stone, gray,
                             neutral, red, rose, orange, green, blue, yellow,
                             violet)
  --alias <alias>            import alias (default: ~)
  --css <path>               CSS file path (default: ./src/styles.css)
  --css-variables            use CSS variables (default: true)
  --no-css-variables         do not use CSS variables
  --no-monorepo              force single-project mode even when monorepo
                             signals are detected
  -w, --workspace <path>     workspace where components are installed (implies
                             monorepo)
  --css-workspace <path>     workspace that owns the CSS file (defaults to
                             --workspace; implies monorepo)
  --prefix <prefix>          Tailwind prefix
  -a, --all                  install all available components (default: false)
  -t, --template <name>      scaffold a project from a template (e.g., acme)
  -h, --help                 display help for command
",
  "remove": "Usage: remove [options] [components...]

remove installed components

Arguments:
  components              component name(s) to remove. If omitted, shows an
