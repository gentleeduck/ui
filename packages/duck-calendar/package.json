{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@gentleduck/calendar",
  "version": "0.1.0",
  "description": "Headless, framework-agnostic calendar engine with date adapter pattern.",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "sideEffects": false,
  "private": false,
  "license": "MIT",
  "author": "gentleduck contributors",
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gentleeduck/duck-ui.git",
    "directory": "packages/duck-calendar"
  },
  "bugs": {
    "url": "https://github.com/gentleeduck/duck-ui/issues"
  },
  "homepage": "https://github.com/gentleeduck/duck-ui/tree/master/packages/duck-calendar#readme",
  "keywords": [
    "gentleduck",
    "calendar",
    "date-adapter",
    "headless"
  ],
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -p tsconfig.json --noEmit --pretty false --skipLibCheck",
    "test": "vitest run",
    "dev": "vitest",
    "benchmark": "bun run scripts/benchmark.ts"
  },
  "devDependencies": {
    "@gentleduck/tsdown-config": "workspace:*",
    "@gentleduck/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/luxon": "^3.6.2",
    "@types/node": "^25.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dayjs": "^1.11.13",
    "jsdom": "^29.0.0",
    "luxon": "^3.6.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsdown": "0.21.4",
    "typescript": "5.9.3",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "date-fns": ">=3.0.0",
    "dayjs": ">=1.11.0",
    "luxon": ">=3.0.0",
    "react": "^19.2.4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "date-fns": {
      "optional": true
    },
    "dayjs": {
      "optional": true
    },
    "luxon": {
      "optional": true
    }
  }
}
