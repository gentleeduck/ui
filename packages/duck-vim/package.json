{
  "$schema": "https://json.schemastore.org/package.json",
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "gentleduck contributors",
  "bugs": {
    "url": "https://github.com/gentleeduck/duck-ui/issues"
  },
  "description": "A keyboard command engine with hotkey parsing, sequences, recording, and React hooks.",
  "devDependencies": {
    "@gentleduck/tsdown-config": "workspace:*",
    "@gentleduck/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^25.3.0",
    "@types/react": "19.2.14",
    "jsdom": "^29.0.0",
    "tsdown": "0.21.7",
    "typescript": "6.0.2",
    "vitest": "^4.0.18"
  },
  "exports": {
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    }
  },
  "sideEffects": false,
  "typesVersions": {
    "*": {
      "command": [
        "./dist/command/index.d.ts"
      ],
      "parser": [
        "./dist/parser/index.d.ts"
      ],
      "platform": [
        "./dist/platform/index.d.ts"
      ],
      "format": [
        "./dist/format/index.d.ts"
      ],
      "matcher": [
        "./dist/matcher/index.d.ts"
      ],
      "sequence": [
        "./dist/sequence/index.d.ts"
      ],
      "recorder": [
        "./dist/recorder/index.d.ts"
      ],
      "react": [
        "./dist/react/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "homepage": "https://github.com/gentleeduck/duck-ui/tree/master/packages/duck-vim#readme",
  "keywords": [
    "gentleduck",
    "vim",
    "keybindings",
    "keyboard",
    "hotkeys",
    "shortcuts",
    "sequences",
    "react"
  ],
  "license": "MIT",
  "module": "./dist/index.js",
  "name": "@gentleduck/vim",
  "packageManager": "bun@1.3.5",
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "directory": "packages/duck-vim",
    "type": "git",
    "url": "git+https://github.com/gentleeduck/duck-ui.git"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "vitest",
    "test": "vitest run",
    "check-types": "tsc -p tsconfig.json --noEmit --pretty false --skipLibCheck"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "0.1.18"
}
