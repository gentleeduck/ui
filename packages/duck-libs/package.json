{
  "$schema": "https://json.schemastore.org/package.json",
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "gentleduck contributors",
  "bugs": {
    "url": "https://github.com/gentleeduck/gentleduck/issues"
  },
  "sideEffects": false,
  "description": "Tiny, framework-agnostic utility functions for gentleduck/ui.",
  "devDependencies": {
    "@gentleduck/tsdown-config": "workspace:*",
    "@gentleduck/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "exports": {
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "homepage": "https://gentleduck.org/duck-ui",
  "keywords": [
    "gentleduck",
    "utilities",
    "helpers",
    "typescript"
  ],
  "license": "MIT",
  "name": "@gentleduck/libs",
  "types": "./dist/index.d.ts",
  "packageManager": "bun@1.3.10",
  "peerDependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "directory": "packages/duck-libs",
    "type": "git",
    "url": "git+https://github.com/gentleeduck/gentleduck.git"
  },
  "scripts": {
    "build": "tsdown",
    "check": "biome check .",
    "check-types": "tsc -p tsconfig.json --noEmit --pretty false --skipLibCheck",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "type": "module",
  "version": "1.0.0"
}
