{
  "$schema": "https://json.schemastore.org/package.json",
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "gentleduck contributors",
  "bugs": {
    "url": "https://github.com/gentleeduck/duck-ui/issues"
  },
  "sideEffects": false,
  "description": "Tiny, framework-agnostic utility functions for gentleduck/ui.",
  "devDependencies": {
    "@gentleduck/tsdown-config": "workspace:*",
    "@gentleduck/typescript-config": "workspace:*",
    "@types/node": "^25.3.0",
    "tsdown": "0.21.7",
    "typescript": "6.0.2",
    "zod": "4.3.6"
  },
  "exports": {
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "homepage": "https://github.com/gentleeduck/duck-ui/tree/master/packages/duck-libs#readme",
  "keywords": [
    "gentleduck",
    "utilities",
    "helpers",
    "typescript"
  ],
  "license": "MIT",
  "name": "@gentleduck/libs",
  "types": "./dist/index.d.ts",
  "packageManager": "bun@1.3.5",
  "peerDependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "directory": "packages/duck-libs",
    "type": "git",
    "url": "git+https://github.com/gentleeduck/duck-ui.git"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -p tsconfig.json --noEmit --pretty false --skipLibCheck",
    "test": "bun test"
  },
  "type": "module",
  "version": "0.1.16"
}
