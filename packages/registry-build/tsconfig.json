{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "outDir": "./dist",
    "paths": {}
  },
  "exclude": [
    "node_modules",
    "dist",
    "**/__test__/**",
    "**/__test__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.tsbuildinfo",
    "tsconfig.tsbuildinfo"
  ],
  "extends": "@gentleduck/typescript-config/internal-package.json",
  "include": ["./"]
}
