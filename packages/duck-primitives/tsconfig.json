{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "outDir": "./dist",
    "paths": {
      "~/*": ["./src/*"]
    },
    "rootDir": "./",
    "types": ["node"]
  },
  "exclude": [
    "node_modules",
    "dist",
    "src/**/__test__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.tsbuildinfo",
    "tsconfig.tsbuildinfo"
  ],
  "extends": "@gentleduck/typescript-config/react.json",
  "include": ["./src/**/*.ts", "./src/**/*.tsx"]
}
