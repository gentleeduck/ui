{
  "$schema": "https://json.schemastore.org/package.json",
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "gentleduck contributors",
  "bugs": {
    "url": "https://github.com/gentleeduck/duck-ui/issues"
  },
  "description": "Unstyled, accessibility-first UI primitives for React.",
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@floating-ui/react": "^0.27.16",
    "@gentleduck/hooks": "workspace:*",
    "@gentleduck/libs": "workspace:*",
    "@gentleduck/tsdown-config": "workspace:*",
    "@gentleduck/typescript-config": "workspace:*",
    "@types/node": "^25.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "mini-svg-data-uri": "^1.4.4",
    "tsdown": "0.21.1"
  },
  "exports": {
    "./hooks/*": "./dist/hooks/*.js",
    "./*": "./dist/*/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/gentleeduck/duck-ui/tree/master/packages/duck-primitives#readme",
  "keywords": [
    "aria",
    "gentleduck",
    "behavioral",
    "component",
    "accessibility",
    "a11y",
    "react-aria",
    "primitives",
    "ui",
    "react"
  ],
  "license": "MIT",
  "module": "./index.ts",
  "name": "@gentleduck/primitives",
  "packageManager": "bun@1.3.5",
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tabbable": "6.2.0"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gentleeduck/duck-ui.git",
    "directory": "packages/duck-primitives"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "tsc -p tsconfig.json --noEmit --pretty false --skipLibCheck",
    "test": "bun test"
  },
  "type": "module",
  "version": "0.2.5",
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.7",
    "aria-hidden": "^1.2.6",
    "react-remove-scroll": "^2.7.2"
  }
}
