{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "outDir": "./dist",
    "paths": {
      "~/*": ["./*"]
    },
    "plugins": [{ "name": "next" }],
    "resolveJsonModule": true,
    "rootDir": "./"
  },
  "exclude": [
    "node_modules",
    "dist",
    "./src/_old",
    "./src/_audio",
    "**/__test__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.tsbuildinfo",
    "tsconfig.tsbuildinfo"
  ],
  "extends": "@gentleduck/typescript-config/motion.json",
  "include": ["./**/*.ts", "./**/*.tsx"]
}
