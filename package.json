{
  "$schema": "https://json.schemastore.org/package.json",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@changesets/cli": "^2.29.8",
    "husky": "^9.1.7",
    "turbo": "^2.7.3",
    "typescript": "5.9.3",
    "vercel": "^50.1.6"
  },
  "name": "duck-ui",
  "description": "gentleduck/ui monorepo for UI components, tools, and related packages.",
  "author": "gentleduck contributors",
  "license": "MIT",
  "homepage": "https://ui.gentleduck.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gentleeduck/duck-ui.git"
  },
  "bugs": {
    "url": "https://github.com/gentleeduck/duck-ui/issues"
  },
  "keywords": [
    "gentleduck",
    "duck-ui",
    "developer-tools",
    "ui",
    "react"
  ],
  "packageManager": "bun@1.3.5",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo test",
    "check": "biome check .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "ci": "bun run lint && bun run format && bun run build",
    "release": "bun run ci && changeset publish",
    "clean": "rimraf dist .cache .turbo node_modules .next .velite",
    "clean:git": "git clean -xdf .cache .turbo node_modules dist",
    "lint:ws": "bunx sherif@latest",
    "postinstall": "bun run lint:ws",
    "prepare": "husky",
    "check-types": "tsc -p tsconfig.json --noEmit --pretty false --skipLibCheck"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tooling/*",
      "!./apps/benchmark/"
    ],
    "catalog": {
      "next": "^16.1.1",
      "lucide-react": "0.562.0",
      "@changesets/cli": "^2.29.8",
      "@tabler/icons-react": "3.36.0",
      "@tanstack/react-query": "^5.90.15",
      "@trpc/client": "^11.8.1",
      "@trpc/react-query": "^11.8.1",
      "@trpc/server": "^11.8.1",
      "@types/node": "^25.3.0",
      "@vitejs/plugin-react-swc": "^3.11.0",
      "@vitest/coverage-v8": "^3.2.4",
      "@vitest/ui": "^3.2.4",
      "react-day-picker": "^9.8.1",
      "tailwindcss": "^4.2.0",
      "tsdown": "0.18.3",
      "typescript": "5.9.3",
      "vite": "npm:rolldown-vite@^7.3.0",
      "vite-bundle-analyzer": "^1.3.2",
      "vite-plugin-inspect": "^11.3.3",
      "vite-tsconfig-paths": "^6.0.3",
      "vitest": "^4.0.16",
      "zod": "4.2.1"
    },
    "catalogs": {
      "react19": {
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "@types/react": "19.2.7",
        "@types/react-dom": "19.2.3"
      }
    }
  }
}
