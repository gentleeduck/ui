{
  "name": "acme-full-stack",
  "private": true,
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "check": "biome check .",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf .turbo",
    "clean:git": "turbo run clean:git",
    "docker:build": "docker compose -f docker/docker-compose.yaml --env-file docker/.env build",
    "docker:up": "docker compose -f docker/docker-compose.yaml --env-file docker/.env up -d",
    "docker:down": "docker compose -f docker/docker-compose.yaml --env-file docker/.env down",
    "docker:logs": "docker compose -f docker/docker-compose.yaml --env-file docker/.env logs -f"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "turbo": "^2.9.14",
    "typescript": "5.9.2"
  },
  "overrides": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tooling/*"
    ],
    "catalog": {
      "next": "^16.1.1",
      "lucide-react": "1.6.0",
      "@tailwindcss/postcss": "^4.2.0",
      "@tabler/icons-react": "3.40.0",
      "@types/node": "^25.3.0",
      "@vitejs/plugin-react-swc": "^4.2.3",
      "@vitest/coverage-v8": "^4.0.18",
      "@vitest/ui": "^4.0.18",
      "tailwindcss": "^4.2.0",
      "tsdown": "0.21.4",
      "typescript": "6.0.2",
      "jsdom": "^29.0.0",
      "vite": "^7.1.12",
      "vite-tsconfig-paths": "^6.0.3",
      "vitest": "^4.0.18",
      "zod": "4.3.6"
    },
    "catalogs": {
      "react19": {
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3"
      }
    }
  }
}
