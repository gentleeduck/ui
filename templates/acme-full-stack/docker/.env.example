COMPOSE_PROJECT_NAME=myapp

# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=replace_with_strong_secret
POSTGRES_DB=app

# Redis
REDIS_PASSWORD=replace_with_strong_secret

# Minio
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=replace_with_strong_secret

# App
NODE_ENV=production
PORT=3000
DATABASE_URL=postgres://app:replace_with_strong_secret@postgres:5432/app
REDIS_URL=redis://default:replace_with_strong_secret@redis:6379
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=replace_with_strong_secret
