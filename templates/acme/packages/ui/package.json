{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@acme/ui",
  "version": "0.4.4",
  "private": false,
  "type": "module",
  "description": "Styled Tailwind components for Acme UI.",
  "author": "Acme",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "acme",
    "react",
    "components",
    "tailwind",
    "ui"
  ],
  "exports": {
    "./index.css": "./index.css",
    "./*": "./src/*/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -p tsconfig.json --noEmit --pretty false --skipLibCheck",
    "test": "vitest run",
    "format": "biome format --write ./",
    "lint": "biome lint --write ./",
    "clean": "rm -rf dist .turbo .cache *.tsbuildinfo",
    "clean:git": "git clean -xdf .cache .turbo node_modules dist"
  },
  "dependencies": {
    "@gentleduck/calendar": "^0.3.0",
    "@gentleduck/hooks": "^0.2.0",
    "@gentleduck/libs": "^0.2.0",
    "@gentleduck/motion": "^0.3.0",
    "@gentleduck/primitives": "^0.2.11",
    "@gentleduck/variants": "^0.1.22",
    "@gentleduck/vim": "^0.2.0",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "catalog:",
    "next-themes": "^0.4.6",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-hook-form": "^7.71.1",
    "react-resizable-panels": "^4.7.0",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.2.0",
    "uuidv7": "^1.1.0",
    "vaul": "1.1.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@acme/tsdown-config": "workspace:*",
    "@acme/typescript-config": "workspace:*",
    "@acme/vitest-config": "workspace:*",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "motion": ">=12.0.0"
  },
  "peerDependenciesMeta": {
    "motion": {
      "optional": true
    }
  }
}
