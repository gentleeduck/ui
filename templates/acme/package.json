{
  "$schema": "https://json.schemastore.org/package.json",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@changesets/cli": "^2.30.0",
    "husky": "^9.1.7",
    "sherif": "1.10.0",
    "turbo": "^2.8.14",
    "typescript": "5.9.3",
    "vercel": "^50.28.0"
  },
  "name": "acme",
  "author": "acme contributors",
  "license": "MIT",
  "homepage": "https://www.acme.com",
  "bugs": {
    "url": "https://github.com/acme/acme-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acme/acme-ui.git",
    "directory": "apps/docs"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "private": true,
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "build": "MODE=\"production\" next build",
    "build:prod": "next build",
    "build:docs": "velite",
    "dev": "next dev",
    "dev:docs": "velite dev",
    "lint": "next lint",
    "check-types": "tsc -p tsconfig.json --noEmit --pretty false --skipLibCheck",
    "postbuild": "next-sitemap && node scripts/fix-required-server-files.mjs",
    "start": "next start --port 3008",
    "preview": "next build && next start"
  },
  "overrides": {
    "@gentleduck/hooks": "^0.1.12",
    "@gentleduck/libs": "^0.1.15",
    "@gentleduck/motion": "^0.1.17",
    "@gentleduck/primitives": "^0.2.5",
    "@gentleduck/variants": "^0.1.20",
    "@gentleduck/vim": "^0.1.16"
  },
  "version": "0.0.1"
}
