{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@acme/tailwind-config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": "Acme",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    "./base": "./base.css",
    "./docs": "./docs.css",
    "./web": "./web.css"
  },
  "scripts": {
    "format": "biome format --write ./",
    "lint": "biome lint --write ./",
    "clean": "rm -rf dist .turbo .cache *.tsbuildinfo",
    "clean:git": "git clean -xdf .cache .turbo node_modules dist"
  }
}
