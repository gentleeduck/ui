{
  "$schema": "https://json.schemastore.org/package.json",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@gentleduck/docs": "workspace:*",
    "@gentleduck/hooks": "workspace:*",
    "@gentleduck/lazy": "workspace:*",
    "@gentleduck/libs": "workspace:*",
    "@gentleduck/motion": "workspace:*",
    "@gentleduck/registers": "workspace:*",
    "@gentleduck/registry-blocks-duckui": "workspace:*",
    "@gentleduck/registry-examples-duckui": "workspace:*",
    "@gentleduck/registry-ui-duckui": "workspace:*",
    "@gentleduck/vim": "workspace:*",
    "@radix-ui/react-icons": "^1.3.2",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "culori": "^4.0.2",
    "date-fns": "^4.1.0",
    "lodash.template": "^4.5.0",
    "lucide-react": "0.562.0",
    "motion": "^12.26.2",
    "next": "^16.1.1",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.4.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-resizable-panels": "^3.0.6",
    "recharts": "^3.7.0",
    "shiki": "^1.12.1",
    "sonner": "^2.0.7",
    "ts-morph": "^27.0.2",
    "tw-animate-css": "^1.2.4",
    "unist-builder": "4.0.0",
    "unist-util-visit": "^5.0.0",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.10",
    "@gentleduck/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/culori": "^4.0.1",
    "@types/lodash.template": "^4.5.3",
    "@types/node": "^25.3.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "^4.2.0",
    "typescript": "5.9.3",
    "velite": "^0.3.1",
    "wrangler": "^4.14.4"
  },
  "name": "@gentleduck/ui-docs",
  "author": "duck-ui contributors",
  "license": "MIT",
  "homepage": "https://www.gentleduck.org",
  "bugs": {
    "url": "https://github.com/gentleeduck/duck-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gentleeduck/duck-ui.git",
    "directory": "apps/duck-ui-docs"
  },
  "private": true,
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "build": "MODE=\"production\" next build",
    "build:full": "next build",
    "build:docs": "bunx velite",
    "build:reg": "./scripts/run-registry-build.sh && biome format --write ./__ui_registry__/index.tsx",
    "dev": "next dev",
    "dev:docs": "bunx velite dev",
    "lint": "next lint",
    "check-types": "tsc -p tsconfig.json --noEmit --pretty false --skipLibCheck",
    "postbuild": "next-sitemap && node scripts/fix-required-server-files.mjs",
    "preview:cf": "bunx @cloudflare/next-on-pages",
    "deploy": "bunx @cloudflare/next-on-pages && mkdir -p .vercel/output/static && bunx wrangler pages deploy .vercel/output/static",
    "deoploy": "bun run deploy",
    "start": "next start --port 3008",
    "preview": "next build && next start"
  },
  "version": "3.0.21"
}
