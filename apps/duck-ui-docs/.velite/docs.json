\"Description\"})]})}),l(r.tbody,{children:e(r.tr,{children:[l(r.td,{children:l(r.code,{__rawString__:\"className\",children:\"className\"})}),l(r.td,{children:l(r.code,{__rawString__:\"string\",children:\"string\"})}),l(r.td,{children:l(r.code,{__rawString__:\"--\",children:\"--\"})}),l(r.td,{children:\"Additional CSS classes to apply\"})]})})]}),\"\\n\",l(r.p,{children:e(r.em,{children:[\"Also accepts all standard HTML \",l(r.code,{__rawString__:\"textarea\",children:\"textarea\"}),\" props (\",l(r.code,{__rawString__:\"placeholder\",children:\"placeholder\"}),\", \",l(r.code,{__rawString__:\"disabled\",children:\"disabled\"}),\", \",l(r.code,{__rawString__:\"value\",children:\"value\"}),\", \",l(r.code,{__rawString__:\"onChange\",children:\"onChange\"}),\", \",l(r.code,{__rawString__:\"rows\",children:\"rows\"}),\", etc.).\"]})})]})}return{default:function(n={}){const{wrapper:e}=n.components||{};return e?l(e,{...n,children:l(_createMdxContent,{...n})}):_createMdxContent(n)}};function _missingMdxReference(n,l){throw new Error(\"Expected \"+(l?\"component\":\"object\")+\" `\"+n+\"` to be defined: you likely forgot to import, pass, or provide it.\")}",
