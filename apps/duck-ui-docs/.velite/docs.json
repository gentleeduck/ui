eact.RefObject<HTMLInputElement | null>\"})}),l(c.td,{children:\"Search input field reference.\"})]}),n(c.tr,{children:[l(c.td,{children:l(c.code,{__rawString__:\"selectedItem\",children:\"selectedItem\"})}),l(c.td,{children:l(c.code,{__rawString__:\"HTMLLIElement | null\",children:\"HTMLLIElement | null\"})}),l(c.td,{children:\"Currently selected item.\"})]}),n(c.tr,{children:[l(c.td,{children:l(c.code,{__rawString__:\"setSelectedItem\",children:\"setSelectedItem\"})}),l(c.td,{children:l(c.code,{__rawString__:\"React.Dispatch<React.SetStateAction<HTMLLIElement | null>>\",children:\"React.Dispatch<React.SetStateAction<HTMLLIElement | null>>\"})}),l(c.td,{children:\"Setter for selected item.\"})]}),n(c.tr,{children:[l(c.td,{children:l(c.code,{__rawString__:\"items\",children:\"items\"})}),l(c.td,{children:l(c.code,{__rawString__:\"React.RefObject<HTMLLIElement[]>\",children:\"React.RefObject<HTMLLIElement[]>\"})}),l(c.td,{children:\"All command items.\"})]}),n(c.tr,{children:[l(c.td,{children:l(c.code,{__rawString__:\"filteredItems\",children:\"filteredItems\"})}),l(c.td,{children:l(c.code,{__rawString__:\"React.RefObject<HTMLLIElement[]>\",children:\"React.RefObject<HTMLLIElement[]>\"})}),l(c.td,{children:\"Filtered items after search.\"})]}),n(c.tr,{children:[l(c.td,{children:l(c.code,{__rawString__:\"groups\",children:\"groups\"})}),l(c.td,{children:l(c.code,{__rawString__:\"React.RefObject<HTMLDivElement[]>\",children:\"React.RefObject<HTMLDivElement[]>\"})}),l(c.td,{children:\"Groups of command items.\"})]})]})]}),\"\\n\",l(c.hr,{}),\"\\n\",n(c.h3,{id:\"commandbadgeprops-commandshortcut\",children:[l(c.a,{\"aria-label\":\"Link to section\",className:\"subheading-anchor\",href:\"#commandbadgeprops-commandshortcut\",children:l(c.span,{className:\"icon icon-link\"})}),l(c.strong,{children:\"CommandBadgeProps (CommandShortcut)\"})]}),\"\\n\",n(c.table,{children:[l(c.thead,{children:n(c.tr,{children:[l(c.th,{children:\"Property\"}),l(c.th,{children:\"Type\"}),l(c.th,{children:\"Description\"})]})}),n(c.tbody,{children:[n(c.tr,{children:[l(c.td,{children:l(c.code,{__rawString__:\"keys\",children:\"keys\"})}),n(c.td,{children:[l(c.code,{__rawString__:\"string\",children:\"string\"}),\" (optional)\"]}),n(c.td,{children:[\"Keyboard shortcut string (e.g. \",l(c.code,{__rawString__:\"'ctrl+K'\",children:\"'ctrl+K'\"}),\").\"]})]}),n(c.tr,{children:[l(c.td,{children:l(c.code,{__rawString__:\"onKeysPressed\",children:\"onKeysPressed\"})}),n(c.td,{children:[l(c.code,{__rawString__:\"() => void\",children:\"() => void\"}),\" (optional)\"]}),l(c.td,{children:\"Called when the shortcut is triggered.\"})]}),n(c.tr,{children:[l(c.td,{children:l(c.code,{__rawString__:\"variant\",children:\"variant\"})}),n(c.td,{children:[l(c.code,{__rawString__:\"'default' | 'secondary'\",children:\"'default' | 'secondary'\"}),\" (optional)\"]}),l(c.td,{children:\"Visual style.\"})]}),n(c.tr,{children:[l(c.td,{children:l(c.code,{__rawString__:\"...props\",children:\"...props\"})}),l(c.td,{children:l(c.code,{__rawString__:\"React.HTMLProps<HTMLElement>\",children:\"React.HTMLProps<HTMLElement>\"})}),n(c.td,{children:[\"Native \",l(c.code,{__rawString__:\"kbd\",children:\"kbd\"}),\" element props.\"]})]})]})]})]})}return{default:function(e={}){const{wrapper:n}=e.components||{};return n?l(n,{...e,children:l(_createMdxContent,{...e})}):_createMdxContent(e)}};function _missingMdxReference(e,l){throw new Error(\"Expected \"+(l?\"component\":\"object\")+\" `\"+e+\"` to be defined: you likely forgot to import, pass, or provide it.\")}",
