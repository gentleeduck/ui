React.ReactNode\",children:\"React.ReactNode\"})}),n(r.td,{children:n(r.code,{__rawString__:\"--\",children:\"--\"})}),n(r.td,{children:\"Menu items to render inside the group\"})]})]})]}),\"\\n\",n(r.p,{children:l(r.em,{children:[\"Also accepts all standard HTML \",n(r.code,{__rawString__:\"div\",children:\"div\"}),\" props.\"]})}),\"\\n\",l(r.h3,{id:\"dropdownmenusub\",children:[n(r.a,{\"aria-label\":\"Link to section\",className:\"subheading-anchor\",href:\"#dropdownmenusub\",children:n(r.span,{className:\"icon icon-link\"})}),\"DropdownMenuSub\"]}),\"\\n\",n(r.p,{children:\"Wrapper for a submenu. Creates a nested popover with hover activation.\"}),\"\\n\",l(r.table,{children:[n(r.thead,{children:l(r.tr,{children:[n(r.th,{children:\"Prop\"}),n(r.th,{children:\"Type\"}),n(r.th,{children:\"Default\"}),n(r.th,{children:\"Description\"})]})}),n(r.tbody,{children:l(r.tr,{children:[n(r.td,{children:n(r.code,{__rawString__:\"contextMenu\",children:\"contextMenu\"})}),n(r.td,{children:n(r.code,{__rawString__:\"boolean\",children:\"boolean\"})}),n(r.td,{children:n(r.code,{__rawString__:\"--\",children:\"--\"})}),n(r.td,{children:\"Open on right-click at the cursor position\"})]})})]}),\"\\n\",n(r.p,{children:l(r.em,{children:[\"Also accepts all \",n(r.code,{__rawString__:\"Popover\",children:\"Popover\"}),\" props.\"]})}),\"\\n\",l(r.h3,{id:\"dropdownmenusubtrigger\",children:[n(r.a,{\"aria-label\":\"Link to section\",className:\"subheading-anchor\",href:\"#dropdownmenusubtrigger\",children:n(r.span,{className:\"icon icon-link\"})}),\"DropdownMenuSubTrigger\"]}),\"\\n\",n(r.p,{children:\"Trigger element for a submenu. Displays a chevron icon indicating a nested menu.\"}),\"\\n\",l(r.table,{children:[n(r.thead,{children:l(r.tr,{children:[n(r.th,{children:\"Prop\"}),n(r.th,{children:\"Type\"}),n(r.th,{children:\"Default\"}),n(r.th,{children:\"Description\"})]})}),n(r.tbody,{children:l(r.tr,{children:[n(r.td,{children:n(r.code,{__rawString__:\"inset\",children:\"inset\"})}),n(r.td,{children:n(r.code,{__rawString__:\"boolean\",children:\"boolean\"})}),n(r.td,{children:n(r.code,{__rawString__:\"false\",children:\"false\"})}),n(r.td,{children:\"Adds left padding to align with inset menu items\"})]})})]}),\"\\n\",n(r.p,{children:l(r.em,{children:[\"Also accepts all \",n(r.code,{__rawString__:\"PopoverTrigger\",children:\"PopoverTrigger\"}),\" props.\"]})}),\"\\n\",l(r.h3,{id:\"dropdownmenusubcontent\",children:[n(r.a,{\"aria-label\":\"Link to section\",className:\"subheading-anchor\",href:\"#dropdownmenusubcontent\",children:n(r.span,{className:\"icon icon-link\"})}),\"DropdownMenuSubContent\"]}),\"\\n\",n(r.p,{children:\"Content container for a submenu.\"}),\"\\n\",l(r.table,{children:[n(r.thead,{children:l(r.tr,{children:[n(r.th,{children:\"Prop\"}),n(r.th,{children:\"Type\"}),n(r.th,{children:\"Default\"}),n(r.th,{children:\"Description\"})]})}),l(r.tbody,{children:[l(r.tr,{children:[n(r.td,{children:n(r.code,{__rawString__:\"disabled\",children:\"disabled\"})}),n(r.td,{children:n(r.code,{__rawString__:\"boolean\",children:\"boolean\"})}),n(r.td,{children:n(r.code,{__rawString__:\"true\",children:\"true\"})}),n(r.td,{children:\"Disables focus management when true\"})]}),l(r.tr,{children:[n(r.td,{children:n(r.code,{__rawString__:\"lockScroll\",children:\"lockScroll\"})}),n(r.td,{children:n(r.code,{__rawString__:\"boolean\",children:\"boolean\"})}),n(r.td,{children:n(r.code,{__rawString__:\"true\",children:\"true\"})}),n(r.td,{children:\"Locks page scroll while the submenu is open\"})]})]})]}),\"\\n\",n(r.p,{children:l(r.em,{children:[\"Also accepts all \",n(r.code,{__rawString__:\"PopoverContent\",children:\"PopoverContent\"}),\" props.\"]})})]})}return{default:function(e={}){const{wrapper:l}=e.components||{};return l?n(l,{...e,children:n(_createMdxContent,{...e})}):_createMdxContent(e)}};function _missingMdxReference(e,n){throw new Error(\"Expected \"+(n?\"component\":\"object\")+\" `\"+e+\"` to be defined: you likely forgot to import, pass, or provide it.\")}",
