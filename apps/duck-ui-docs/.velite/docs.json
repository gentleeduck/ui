n(r.h3,{id:\"responsive-variants\",children:[l(r.a,{\"aria-label\":\"Link to section\",className:\"subheading-anchor\",href:\"#responsive-variants\",children:l(r.span,{className:\"icon icon-link\"})}),\"Responsive Variants\"]}),\"\\n\",n(r.p,{children:[\"The following responsive components automatically render a \",l(r.code,{__rawString__:\"Dialog\",children:\"Dialog\"}),\" on desktop (>=768px) and a \",l(r.code,{__rawString__:\"Drawer\",children:\"Drawer\"}),\" on mobile. Each accepts the same props as its non-responsive counterpart.\"]}),\"\\n\",n(r.table,{children:[l(r.thead,{children:n(r.tr,{children:[l(r.th,{children:\"Component\"}),l(r.th,{children:\"Desktop renders\"}),l(r.th,{children:\"Mobile renders\"})]})}),n(r.tbody,{children:[n(r.tr,{children:[l(r.td,{children:l(r.code,{__rawString__:\"DialogResponsive\",children:\"DialogResponsive\"})}),l(r.td,{children:l(r.code,{__rawString__:\"Dialog\",children:\"Dialog\"})}),l(r.td,{children:l(r.code,{__rawString__:\"Drawer\",children:\"Drawer\"})})]}),n(r.tr,{children:[l(r.td,{children:l(r.code,{__rawString__:\"DialogTriggerResponsive\",children:\"DialogTriggerResponsive\"})}),l(r.td,{children:l(r.code,{__rawString__:\"DialogTrigger\",children:\"DialogTrigger\"})}),l(r.td,{children:l(r.code,{__rawString__:\"DrawerTrigger\",children:\"DrawerTrigger\"})})]}),n(r.tr,{children:[l(r.td,{children:l(r.code,{__rawString__:\"DialogContentResponsive\",children:\"DialogContentResponsive\"})}),l(r.td,{children:l(r.code,{__rawString__:\"DialogContent\",children:\"DialogContent\"})}),l(r.td,{children:l(r.code,{__rawString__:\"DrawerContent\",children:\"DrawerContent\"})})]}),n(r.tr,{children:[l(r.td,{children:l(r.code,{__rawString__:\"DialogHeaderResponsive\",children:\"DialogHeaderResponsive\"})}),l(r.td,{children:l(r.code,{__rawString__:\"DialogHeader\",children:\"DialogHeader\"})}),l(r.td,{children:l(r.code,{__rawString__:\"DrawerHeader\",children:\"DrawerHeader\"})})]}),n(r.tr,{children:[l(r.td,{children:l(r.code,{__rawStrin