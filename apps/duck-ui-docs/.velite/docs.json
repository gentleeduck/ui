" props.\"]})}),\"\\n\",n(r.h3,{id:\"fielderror\",children:[e(r.a,{\"aria-label\":\"Link to section\",className:\"subheading-anchor\",href:\"#fielderror\",children:e(r.span,{className:\"icon icon-link\"})}),\"FieldError\"]}),\"\\n\",n(r.p,{children:[\"Accessible error container that accepts children or an \",e(r.code,{__rawString__:\"errors\",children:\"errors\"}),\" array (e.g., from \",e(r.code,{__rawString__:\"react-hook-form\",children:\"react-hook-form\"}),\").\"]}),\"\\n\",n(r.table,{children:[e(r.thead,{children:n(r.tr,{children:[e(r.th,{children:\"Prop\"}),e(r.th,{children:\"Type\"}),e(r.th,{children:\"Default\"}),e(r.th,{children:\"Description\"})]})}),n(r.tbody,{children:[n(r.tr,{children:[e(r.td,{children:e(r.code,{__rawString__:\"errors\",children:\"errors\"})}),e(r.td,{children:e(r.code,{__rawString__:\"Array<{ message?: string } | undefined>\",children:\"Array<{ message?: string } | undefined>\"})}),e(r.td,{children:e(r.code,{__rawString__:\"--\",children:\"--\"})}),e(r.td,{children:\"Array of error objects from a form library\"})]}),n(r.tr,{children:[e(r.td,{children:e(r.code,{__rawString__:\"children\",children:\"children\"})}),e(r.td,{children:e(r.code,{__rawString__:\"React.ReactNode\",children:\"React.ReactNode\"})}),e(r.td,{children:e(r.code,{__rawString__:\"--\",children:\"--\"})}),n(r.td,{children:[\"Custom error content (takes precedence over \",e(r.code,{__rawString__:\"errors\",children:\"errors\"}),\")\"]})]}),n(r.tr,{children:[e(r.td,{children:e(r.code,{__rawString__:\"className\",children:\"className\"})}),e(r.td,{children:e(r.code,{__rawString__:\"string\",children:\"string\"})}),e(r.td,{children:e(r.code,{__rawString__:\"--\",children:\"--\"})}),e(r.td,{children:\"Additional CSS classes\"})]})]})]}),\"\\n\",e(r.p,{children:n(r.em,{children:[\"Also accepts all standard HTML \",e(r.code,{__rawString__:\"div\",children:\"div\"}),\" props.\"]})}),\"\\n\",n(r.p,{children:[\"When the \",e(r.code,{__rawString__:\"errors\",children:\"errors\"}),\" array contains multiple messages, the component renders a list automatically.\"]}),\"\\n\",n(r.p,{children:[e(r.code,{__rawString__:\"FieldError\",children:\"FieldError\"}),\" also accepts issues produced by any validator that implements \",e(r.a,{href:\"https://standardschema.dev/\",children:\"Standard Schema\"}),\", including Zod, Valibot, and ArkType. Pass the \",e(r.code,{__rawString__:\"issues\",children:\"issues\"}),\" array from the schema result directly to render a unified error list across libraries.\"]})]})}return{default:function(l={}){const{wrapper:n}=l.components||{};return n?e(n,{...l,children:e(_createMdxContent,{...l})}):_createMdxContent(l)}};function _missingMdxReference(l,e){throw new Error(\"Expected \"+(e?\"component\":\"object\")+\" `\"+l+\"` to be defined: you likely forgot to import, pass, or provide it.\")}",
