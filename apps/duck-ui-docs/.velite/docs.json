the trigger button\"})]}),n(c.tr,{children:[l(c.td,{children:l(c.code,{__rawString__:\"contentRef\",children:\"contentRef\"})}),l(c.td,{children:l(c.code,{__rawString__:\"React.RefObject<HTMLDivElement | null>\",children:\"React.RefObject<HTMLDivElement | null>\"})}),n(c.td,{children:[\"Ref to the scrollable dropdown content \",l(c.code,{__rawString__:\"<div>\",children:\"<div>\"})]})]}),n(c.tr,{children:[l(c.td,{children:l(c.code,{__rawString__:\"groupsRef\",children:\"groupsRef\"})}),l(c.td,{children:l(c.code,{__rawString__:\"React.RefObject<HTMLUListElement[] | null>\",children:\"React.RefObject<HTMLUListElement[] | null>\"})}),n(c.td,{children:[\"Ref to groups \",l(c.code,{__rawString__:\"<ul>\",children:\"<ul>\"}),\" elements\"]})]}),n(c.tr,{children:[l(c.td,{children:l(c.code,{__rawString__:\"itemsRef\",children:\"itemsRef\"})}),l(c.td,{children:l(c.code,{__rawString__:\"React.RefObject<HTMLLIElement[] | null>\",children:\"React.RefObject<HTMLLIElement[] | null>\"})}),n(c.td,{children:[\"Ref to the list of select items \",l(c.code,{__rawString__:\"<li>\",children:\"<li>\"})]})]}),n(c.tr,{children:[l(c.td,{children:l(c.code,{__rawString__:\"selectedItem\",children:\"selectedItem\"})}),l(c.td,{children:l(c.code,{__rawString__:\"HTMLLIElement | null\",children:\"HTMLLIElement | null\"})}),l(c.td,{children:\"Currently selected item DOM element\"})]}),n(c.tr,{children:[l(c.td,{children:l(c.code,{__rawString__:\"scrollable\",children:\"scrollable\"})}),l(c.td,{children:l(c.code,{__rawString__:\"boolean\",children:\"boolean\"})}),l(c.td,{children:\"If the dropdown is scrollable\"})]})]})]})]})}return{default:function(e={}){const{wrapper:n}=e.components||{};return n?l(n,{...e,children:l(_createMdxContent,{...e})}):_createMdxContent(e)}};function _missingMdxReference(e,l){throw new Error(\"Expected \"+(l?\"component\":\"object\")+\" `\"+e+\"` to be defined: you likely forgot to import, pass, or provide it.\")}",
