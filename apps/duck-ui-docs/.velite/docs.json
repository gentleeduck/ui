k\",children:n(c.span,{className:\"line\",children:[e(c.span,{style:{color:\"#94E2D5\"},children:\"<\"}),e(c.span,{style:{color:\"#F5C2E7\"},children:\"DataTableViewOptions\"}),e(c.span,{style:{color:\"#F9E2AF\"},children:\" table\"}),e(c.span,{style:{color:\"#94E2D5\"},children:\"=\"}),e(c.span,{style:{color:\"#9399B2\"},children:\"{\"}),e(c.span,{style:{color:\"#CDD6F4\"},children:\"table\"}),e(c.span,{style:{color:\"#9399B2\"},children:\"}\"}),e(c.span,{style:{color:\"#94E2D5\"},children:\" />\"})]})})}),e(c.pre,{\"data-language\":\"tsx\",\"data-theme\":\"light\",__rawString__:\"<DataTableViewOptions table={table} />\",children:e(c.code,{\"data-language\":\"tsx\",\"data-theme\":\"light\",children:n(c.span,{className:\"line\",children:[e(c.span,{style:{color:\"#24292E\"},children:\"<\"}),e(c.span,{style:{color:\"#005CC5\"},children:\"DataTableViewOptions\"}),e(c.span,{style:{color:\"#6F42C1\"},children:\" table\"}),e(c.span,{style:{color:\"#D73A49\"},children:\"=\"}),e(c.span,{style:{color:\"#24292E\"},children:\"{table} />\"})]})})})]})]})}return{default:function(l={}){const{wrapper:n}=l.components||{};return n?e(n,{...l,children:e(_createMdxContent,{...l})}):_createMdxContent(l)}};function _missingMdxReference(l,e){throw new Error(\"Expected \"+(e?\"component\":\"object\")+\" `\"+l+\"` to be defined: you likely forgot to import, pass, or provide it.\")}",
