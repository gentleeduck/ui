\"})}),n(r.td,{children:\"--\"}),n(r.td,{children:\"Additional class names for the separator div\"})]}),e(r.tr,{children:[n(r.td,{children:n(r.code,{__rawString__:\"customIndicator\",children:\"customIndicator\"})}),n(r.td,{children:n(r.code,{__rawString__:\"React.ReactNode\",children:\"React.ReactNode\"})}),n(r.td,{children:\"--\"}),n(r.td,{children:\"Custom element to render instead of the default dot icon\"})]}),e(r.tr,{children:[n(r.td,{children:n(r.code,{__rawString__:\"ref\",children:\"ref\"})}),n(r.td,{children:n(r.code,{__rawString__:\"React.Ref<HTMLDivElement>\",children:\"React.Ref<HTMLDivElement>\"})}),n(r.td,{children:\"--\"}),n(r.td,{children:\"Ref forwarded to the separator div\"})]})]})]}),\"\\n\",n(r.p,{children:e(r.em,{children:[\"Also accepts all standard HTML \",n(r.code,{__rawString__:\"div\",children:\"div\"}),\" props.\"]})})]})}return{default:function(l={}){const{wrapper:e}=l.components||{};return e?n(e,{...l,children:n(_createMdxContent,{...l})}):_createMdxContent(l)}};function _missingMdxReference(l,n){throw new Error(\"Expected \"+(n?\"component\":\"object\")+\" `\"+l+\"` to be defined: you likely forgot to import, pass, or provide it.\")}",
