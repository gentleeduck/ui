{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "noErrorTruncation": true,
    "paths": {
      "@gentleduck/registry-build": ["../../packages/registry-build/src/index.ts"],
      "~/*": ["./*"],
      "@gentleduck/primitives/*": ["../../packages/duck-primitives/src/*"],
      "@gentleduck/registry-internals/*": ["../../packages/registry-internals/src/*"],
      "~/velite": ["./.velite/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strictPropertyInitialization": false,
    "types": ["@types/react", "node"],
    "useDefineForClassFields": true
  },
  "exclude": ["node_modules", "dist", "**/__test__/**", "**/*.test.ts"],
  "extends": "@gentleduck/typescript-config/nextjs.json",
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".velite"]
}
