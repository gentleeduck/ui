      "content": "import { InputGroup, InputGroupAddon, InputGroupButton, InputGroupInput } from '@gentleduck/registry-ui/input-group'\r\nimport { Tooltip, TooltipContent, TooltipProvider, TooltipTrigger } from '@gentleduck/registry-ui/tooltip'\r\nimport { HelpCircle, InfoIcon } from 'lucide-react'\r\n\r\nexport default function Demo() {\r\n  return (\r\n    <TooltipProvider>\r\n      <div className=\"grid w-full max-w-sm gap-4\">\r\n        <InputGroup>\r\n          <InputGroupInput placeholder=\"Paste your SSH public key\" />\r\n          <InputGroupAddon align=\"inline-end\">\r\n            <Tooltip>\r\n              <TooltipTrigger asChild>\r\n                <InputGroupButton aria-label=\"Info\" size=\"icon-xs\" variant=\"ghost\">\r\n                  <InfoIcon />\r\n                </InputGroupButton>\r\n              </TooltipTrigger>\r\n              <TooltipContent align=\"end\" side=\"top\">\r\n                <p>Starts with ssh-rsa, ssh-ed25519, or ecdsa-sha2</p>\r\n              </TooltipContent>\r\n            </Tooltip>\r\n          </InputGroupAddon>\r\n        </InputGroup>\r\n        <InputGroup>\r\n          <InputGroupInput placeholder=\"https://hooks.example.com/events\" />\r\n          <InputGroupAddon align=\"inline-end\">\r\n            <Tooltip>\r\n              <TooltipTrigger asChild>\r\n                <InputGroupButton aria-label=\"Help\" size=\"icon-xs\" variant=\"ghost\">\r\n                  <HelpCircle />\r\n                </InputGroupButton>\r\n              </TooltipTrigger>\r\n              <TooltipContent align=\"end\" side=\"top\">\r\n                <p>Webhook events are sent as POST requests</p>\r\n              </TooltipContent>\r\n            </Tooltip>\r\n          </InputGroupAddon>\r\n        </InputGroup>\r\n        <InputGroup>\r\n          <InputGroupInput placeholder=\"DATABASE_URL\" />\r\n          <Tooltip>\r\n            <TooltipTrigger asChild>\r\n              <InputGroupAddon>\r\n                <InputGroupButton aria-label=\"Help\" size=\"icon-xs\" variant=\"ghost\">\r\n                  <HelpCircle />\r\n                </InputGroupButton>\r\n              </InputGroupAddon>\r\n            </TooltipTrigger>\r\n            <TooltipContent align=\"end\" side=\"top\">\r\n              <p>Environment variables are encrypted at rest</p>\r\n            </TooltipContent>\r\n          </Tooltip>\r\n        </InputGroup>\r\n      </div>\r\n    </TooltipProvider>\r\n  )\r\n}\r\n",
      "path": "input-group/input-group-5.tsx",
      "target": "components/input-group-5.tsx",
      "type": "registry:example"
    }
  ],
