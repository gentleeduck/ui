      "content": "import { Checkbox } from '@gentleduck/registry-ui/checkbox'\r\nimport {\r\n  Field,\r\n  FieldDescription,\r\n  FieldGroup,\r\n  FieldLabel,\r\n  FieldSeparator,\r\n  FieldSet,\r\n} from '@gentleduck/registry-ui/field'\r\n\r\nexport default function Demo() {\r\n  return (\r\n    <div className=\"w-full max-w-md\">\r\n      <FieldGroup>\r\n        <FieldSet>\r\n          <FieldLabel>Responses</FieldLabel>\r\n          <FieldDescription>\r\n            Get notified when ChatGPT responds to requests that take time, like research or image generation.\r\n          </FieldDescription>\r\n          <FieldGroup data-slot=\"checkbox-group\">\r\n            <Field orientation=\"horizontal\">\r\n              <Checkbox defaultChecked disabled id=\"push\" />\r\n              <FieldLabel className=\"font-normal\" htmlFor=\"push\">\r\n                Push notifications\r\n              </FieldLabel>\r\n            </Field>\r\n          </FieldGroup>\r\n        </FieldSet>\r\n        <FieldSeparator />\r\n        <FieldSet>\r\n          <FieldLabel>Tasks</FieldLabel>\r\n          <FieldDescription>\r\n            {/* biome-ignore lint/a11y/useValidAnchor: placeholder href in demo component */}\r\n            Get notified when tasks you&apos;ve created have updates. <a href=\"#\">Manage tasks</a>\r\n          </FieldDescription>\r\n          <FieldGroup data-slot=\"checkbox-group\">\r\n            <Field orientation=\"horizontal\">\r\n              <Checkbox id=\"push-tasks\" />\r\n              <FieldLabel className=\"font-normal\" htmlFor=\"push-tasks\">\r\n                Push notifications\r\n              </FieldLabel>\r\n            </Field>\r\n            <Field orientation=\"horizontal\">\r\n              <Checkbox id=\"email-tasks\" />\r\n              <FieldLabel className=\"font-normal\" htmlFor=\"email-tasks\">\r\n                Email notifications\r\n              </FieldLabel>\r\n            </Field>\r\n          </FieldGroup>\r\n        </FieldSet>\r\n      </FieldGroup>\r\n    </div>\r\n  )\r\n}\r\n",
