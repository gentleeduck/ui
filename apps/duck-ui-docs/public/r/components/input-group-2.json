      "content": "import { InputGroup, InputGroupAddon, InputGroupInput } from '@gentleduck/registry-ui/input-group'\r\nimport { AtSignIcon, CheckCircleIcon, GlobeIcon, LinkIcon, PackageIcon, PhoneIcon } from 'lucide-react'\r\n\r\nexport default function Demo() {\r\n  return (\r\n    <div className=\"grid w-full max-w-sm gap-6\">\r\n      <InputGroup>\r\n        <InputGroupInput placeholder=\"+1 (555) 000-0000\" type=\"tel\" />\r\n        <InputGroupAddon>\r\n          <PhoneIcon />\r\n        </InputGroupAddon>\r\n      </InputGroup>\r\n      <InputGroup>\r\n        <InputGroupInput placeholder=\"Enter tracking number\" />\r\n        <InputGroupAddon>\r\n          <PackageIcon />\r\n        </InputGroupAddon>\r\n      </InputGroup>\r\n      <InputGroup>\r\n        <InputGroupInput placeholder=\"Look up domain\" />\r\n        <InputGroupAddon>\r\n          <GlobeIcon />\r\n        </InputGroupAddon>\r\n        <InputGroupAddon align=\"inline-end\">\r\n          <CheckCircleIcon />\r\n        </InputGroupAddon>\r\n      </InputGroup>\r\n      <InputGroup>\r\n        <InputGroupInput placeholder=\"username\" />\r\n        <InputGroupAddon>\r\n          <AtSignIcon />\r\n        </InputGroupAddon>\r\n        <InputGroupAddon align=\"inline-end\">\r\n          <LinkIcon />\r\n        </InputGroupAddon>\r\n      </InputGroup>\r\n    </div>\r\n  )\r\n}\r\n",
