      "content": "import {\n  Pagination,\n  PaginationContent,\n  PaginationEllipsis,\n  PaginationItem,\n  PaginationLink,\n  PaginationNext,\n  PaginationPrevious,\n} from '@gentleduck/registry-ui-duckui/pagination'\n\nexport default function PaginationRtlDemo() {\n  return (\n    <div dir=\"rtl\" className=\"flex justify-center\">\n      <Pagination>\n        <PaginationContent>\n          {/* In RTL: Next comes first (visually right side) */}\n          <PaginationItem>\n            <PaginationNext href=\"#\" text=\"التالي\" />\n          </PaginationItem>\n\n          <PaginationItem>\n            <PaginationEllipsis text=\"صفحات أخرى\" />\n          </PaginationItem>\n\n          <PaginationItem>\n            <PaginationLink href=\"#\">٣</PaginationLink>\n          </PaginationItem>\n\n          <PaginationItem>\n            <PaginationLink href=\"#\" isActive>\n              ٢\n            </PaginationLink>\n          </PaginationItem>\n\n          <PaginationItem>\n            <PaginationLink href=\"#\">١</PaginationLink>\n          </PaginationItem>\n\n          {/* Previous goes at the end (visually left side) */}\n          <PaginationItem>\n            <PaginationPrevious href=\"#\" text=\"السابق\" />\n          </PaginationItem>\n        </PaginationContent>\n      </Pagination>\n    </div>\n  )\n}\n",
