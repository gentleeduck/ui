      "content": "'use client'\n\nimport { Button } from '@gentleduck/registry-ui/button'\nimport {\n  DialogClose,\n  DialogDescription,\n  DialogFooter,\n  DialogHeader,\n  DialogTitle,\n  DialogTrigger,\n  MotionDialog,\n  MotionDialogContent,\n} from '@gentleduck/registry-ui/dialog'\nimport { Input } from '@gentleduck/registry-ui/input'\nimport { Label } from '@gentleduck/registry-ui/label'\n\nexport default function Demo() {\n  return (\n    <MotionDialog>\n      <form onSubmit={(e) => e.preventDefault()}>\n        <DialogTrigger asChild>\n          <Button variant={'outline'}>Open Dialog</Button>\n        </DialogTrigger>\n        <MotionDialogContent className=\"sm:max-w-[425px]\">\n          <DialogHeader>\n            <DialogTitle>Edit profile</DialogTitle>\n            <DialogDescription>Make changes to your profile here. Click save when you&apos;re done.</DialogDescription>\n          </DialogHeader>\n\n          <div className=\"grid gap-4\">\n            <div className=\"grid gap-3\">\n              <Label htmlFor=\"name-5\">Name</Label>\n              <Input defaultValue=\"Pedro Duarte\" id=\"name-5\" name=\"name\" />\n            </div>\n            <div className=\"grid gap-3\">\n              <Label htmlFor=\"username-5\">Username</Label>\n              <Input defaultValue=\"@peduarte\" id=\"username-5\" name=\"username\" />\n            </div>\n          </div>\n          <DialogFooter>\n            <DialogClose asChild>\n              <Button variant={'outline'}>Cancel</Button>\n            </DialogClose>\n            <Button type=\"submit\">Save changes</Button>\n          </DialogFooter>\n        </MotionDialogContent>\n      </form>\n    </MotionDialog>\n  )\n}\n",
      "path": "dialog/dialog-5.tsx",
      "target": "components/dialog-5.tsx",
      "type": "registry:example"
    }
