\n            </Avatar>\r\n          </div>\r\n        </ItemMedia>\r\n        <ItemContent>\r\n          <ItemTitle>Design Review Group</ItemTitle>\r\n          <ItemDescription>3 reviewers awaiting your feedback on the mockups.</ItemDescription>\r\n        </ItemContent>\r\n        <ItemActions>\r\n          <Button size=\"sm\" variant=\"outline\">\r\n            Review\r\n          </Button>\r\n        </ItemActions>\r\n      </Item>\r\n    </div>\r\n  )\r\n}\r\n",
