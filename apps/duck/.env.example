# Docs app runtime environment.
# Registry build paths and sources are configured in ./registry-build.config.ts, not here.
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/r93Qvam8
NEXT_PUBLIC_SPONSOR_URL=https://opencollective.com/gentelduck

# AI Chat
# Set to "true" to show the AI chat toggle in the command menu (build-time, no runtime API call)
NEXT_PUBLIC_AI_CHAT_ENABLED=true
# Use one of these providers (OpenRouter recommended, free tier)
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Or use Google Gemini: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: override the model
# CHAT_MODEL=google/gemini-2.0-flash-exp:free
